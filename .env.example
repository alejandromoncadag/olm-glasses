APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_your_stripe_webhook_signing_secret
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_GOOGLE_ID=replace_with_your_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_your_google_oauth_client_secret

# Read-only OPTICAOLM catalog bridge (server-only; never use NEXT_PUBLIC_).
CATALOG_MODE=legacy
CATALOG_LEGACY_FALLBACK_ENABLED=true
CATALOG_REQUEST_TIMEOUT_MS=3000
OPTICAOLM_CATALOG_API_URL=http://127.0.0.1:8000
OPTICAOLM_CATALOG_BEARER_TOKEN=replace_with_the_same_backend_catalog_token
OPTICAOLM_CATALOG_IMAGE_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Phase 1F-A. Use legacy, shadow, or optica. Only optica changes what customers use.
ONLINE_COMMERCE_MODE=legacy
PHASE_1FB1_ENABLED=false
PHASE_1FB2_ENABLED=false
PHASE_1FC1_ENABLED=false
PHASE_1FC2A_ENABLED=false
OPTICAOLM_COMMERCE_API_URL=http://127.0.0.1:8000
OPTICAOLM_COMMERCE_BEARER_TOKEN=replace_with_the_same_backend_commerce_token
ONLINE_COMMERCE_IDENTITY_SECRET=replace_with_a_long_random_server_only_hmac_secret
ONLINE_COMMERCE_REQUEST_TIMEOUT_MS=3000

# Phase 1G-E verified identity bridge (server-only; never use NEXT_PUBLIC_).
PHASE_1GE_ENABLED=false
OPTICAOLM_IDENTITY_API_URL=http://127.0.0.1:8000
OPTICAOLM_IDENTITY_BEARER_TOKEN=replace_with_the_same_backend_identity_token
ONLINE_IDENTITY_REQUEST_TIMEOUT_MS=3000

# Durable password-email verification. Keep provider credentials server-only.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Óptica OLM <no-reply@example.com>
EMAIL_VERIFICATION_DEV_LINKS=false
